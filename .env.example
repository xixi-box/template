# ============================================================
# 环境变量配置模板 (.env.example)
# 适用: 所有使用 docker-compose.dev.yml 的项目
# 来源: code-craft + lumina-rpc 两项目合并
#
# 使用方式:
#   1. 复制本文件为 .env: cp .env.example .env
#   2. 填入实际值 (所有 <set-value> 必须替换)
#   3. .env 已在 .gitignore 中，不会被提交
# ============================================================

# --- 项目标识 ---
# 用于 docker-compose 中的容器命名前缀和变量名前缀
PROJECT_NAME=<project>

# ============================================================
# MySQL 数据库
# ============================================================
<PROJECT>_MYSQL_ROOT_PASSWORD=<set-value>
<PROJECT>_MYSQL_DATABASE=<project>_db
<PROJECT>_MYSQL_USERNAME=<project>_user
<PROJECT>_MYSQL_PASSWORD=<set-value>
<PROJECT>_MYSQL_PORT=3306

# ============================================================
# Redis
# ============================================================
<PROJECT>_REDIS_PORT=6379
# <PROJECT>_REDIS_PASSWORD=<set-value>

# ============================================================
# [可选] Nacos (Spring Cloud Alibaba / Dubbo 项目)
# ============================================================
# <PROJECT>_NACOS_PORT=8848
# <PROJECT>_NACOS_USERNAME=nacos
# <PROJECT>_NACOS_PASSWORD=<set-value>
# <PROJECT>_NACOS_AUTH_TOKEN=<set-value>

# ============================================================
# [可选] Dubbo RPC 端口
# ============================================================
# <PROJECT>_DUBBO_HOST=localhost

# ============================================================
# [可选] Spring Boot 业务环境变量
# 以下为常见配置项，按项目需要增减
# ============================================================
# LOG_LEVEL=INFO
# SPRING_PROFILES_ACTIVE=local

# --- [可选] AI 服务密钥 ---
# DASHSCOPE_API_KEY=<set-value>
# DEEPSEEK_API_KEY=<set-value>

# --- [可选] 对象存储 ---
# TENCENT_COS_SECRET_ID=<set-value>
# TENCENT_COS_SECRET_KEY=<set-value>
# TENCENT_COS_REGION=ap-shanghai
# TENCENT_COS_BUCKET=<your-bucket>
# TENCENT_COS_HOST=https://<your-bucket>.cos.<region>.myqcloud.com

# ============================================================
# [可选] 前端 Vite 环境变量
# ============================================================
# VITE_DEPLOY_DOMAIN=http://localhost
# VITE_API_BASE_URL=/api
